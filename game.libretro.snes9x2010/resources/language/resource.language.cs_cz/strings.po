msgctxt "Addon Summary"
msgid "Nintendo - SNES / SFC (Snes9x 2010)"
msgstr "Nintendo - SNES / SFC (Snes9x 2010)"

msgctxt "Addon Description"
msgid "A port of Snes9x 1.52+ to Libretro. Rewritten in C with several optimizations and speedhacks."
msgstr "Port Snes9x 1.52+ pro Libretro. Byl přepsán do C a obsahuje několik optimalizací a speedhacků."

msgctxt "Addon Disclaimer"
msgid "Icon credit: HarryBana (harrybana.deviantart.com)"
msgstr "Autor ikony: HarryBana (harrybana.deviantart.com)"

msgctxt "#30001"
msgid "Console Region (Restart)"
msgstr "Region konzole (vyžaduje restart)"

msgctxt "#30002"
